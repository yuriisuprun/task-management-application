# ========================================
# ROOT LEVEL GITIGNORE
# Shared rules for entire project
# ========================================

# ========== IDE & EDITOR ==========
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# VS Code
.vscode/
*.code-workspace
.history/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/
.c9/
*.launch
.scalafmt.conf
bin/

# NetBeans
nbproject/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml
.nb-gradle/

# Vim
*.swp
*.swo
*~
.*.swp
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# OSX
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.VisualState.xml

# ========== ENVIRONMENT & SECRETS ==========
# Environment variables (NEVER commit)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# Secrets and credentials
*.pem
*.key
*.crt
*.p12
*.pfx
.ssh/
private_key
secret.txt
credentials.json
secrets/
.secrets/

# ========== BUILD & ARTIFACTS ==========
# Local Maven/Gradle
.m2/
.gradle/
build/
dist/
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Local Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml
yarn.lock

# ========== LOGS ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log

# ========== RUNTIME DATA ==========
pids/
*.pid
*.seed
*.pid.lock

# ========== DATABASE ==========
*.db
*.sqlite
*.sqlite3
database.sqlite
.database/

# ========== TEMPORARY FILES ==========
tmp/
temp/
cache/
.cache/
**/temp/
**/tmp/

# ========== IDE TEMP FILES ==========
*.tmp
*.bak
*.swp
*.swo
*#
.#*
*~

# ========== SYSTEM FILES ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.viminfo

# ========== DOCKER ==========
.dockerignore
docker-compose.override.yml
docker-compose.local.yml
Dockerfile.local

# ========== TESTING ==========
coverage/
.nyc_output/
junit.xml
.jest/
test-results/

# ========== CI/CD ==========
.github/workflows/local-*.yml
.gitlab-ci.local.yml
.travis/local/

# ========== MISC ==========
.local/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# Don't ignore these even though they match patterns above
!.gitkeep
!.env.example
!.env.template
!.env.example.local

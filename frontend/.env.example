# ========================================
# FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# Copy to .env or .env.local and update
# ========================================

# ========== API CONFIGURATION ==========
# Backend API URL
VITE_API_URL=http://localhost:8080
VITE_API_TIMEOUT=30000

# ========== DEVELOPMENT SERVER ==========
# Vite Server Configuration
VITE_HOST=localhost
VITE_PORT=3000

# ========== APPLICATION ==========
# Application Name and Environment
VITE_APP_NAME=Task Management
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# ========== LOGGING ==========
# Debug and Logging
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# ========== FEATURE FLAGS ==========
# Feature Toggles (for gradually rolling out features)
VITE_FEATURE_SEARCH=true
VITE_FEATURE_FILTER=true
VITE_FEATURE_PAGINATION=true

# ========== UI CONFIGURATION ==========
# UI Settings
VITE_ITEMS_PER_PAGE=10
VITE_ENABLE_ANIMATIONS=true
VITE_THEME=light

# ========== ANALYTICS (Optional) ==========
# Google Analytics, Sentry, etc.
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# ========== SECURITY ==========
# Note: Client-side env vars are PUBLIC
# Never store secrets here!
# Use backend .env for sensitive data
